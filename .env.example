# ==========================================
# n8n & WhatsApp API Configuration
# ==========================================

# Port and Base URL for n8n instance
N8N_PORT=5678
N8N_HOST=localhost
WEBHOOK_URL=https://your-n8n-domain.com/

# Meta WhatsApp Cloud API / Business API Credentials
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
WHATSAPP_ACCESS_TOKEN=your_whatsapp_permanent_access_token
WHATSAPP_VERIFY_TOKEN=your_custom_webhook_verify_token

# Basic Authentication for Disease Surveillance Endpoint
HTTP_BASIC_AUTH_USER=pdsru_admin
HTTP_BASIC_AUTH_PASS=your_secure_password_here

# Timezone Setting
GENERIC_TIMEZONE=Asia/Karachi